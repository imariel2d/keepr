# Copy to .env and fill in. Loaded by your shell / docker; never commit the real .env.
# In App Platform these are set as SECRET env vars (see .do/app.yaml).

# --- Database ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=media;Username=media;Password=media

# --- Sessions ---
# Nothing to set: sessions are random per-login tokens stored (hashed) in the database, so there
# is no signing secret to leak or rotate. Defaults live in appsettings.json; override
# Session__LifetimeDays to change how long an idle session survives.

# --- Registration gate ---
# Shared invite code required to create an account. Empty (the default here, matching
# appsettings.json) refuses all signups — fail-closed. Set a long random string to open
# registration; rotate by changing it and restarting. See docs/registration-gate-design.md.
Registration__InviteCode=

# --- Shareable links ---
# Required: the absolute http(s) origin the public share-link viewer is served from (the SPA
# origin). The app refuses to start without it. Dev: http://localhost:4200. Prod: your public URL.
Sharing__PublicBaseUrl=http://localhost:4200

# --- First admin (bootstrap) ---
# Seeds the initial admin account at startup so the admin console is reachable — signups are
# invite-gated, so no account can grant itself the role. Leave both blank to skip seeding.
# If the account already exists it is promoted to admin (its password is NOT changed).
# The password here is an INITIAL secret only: change it after the first sign-in. Once the
# account exists, editing Admin__Password does nothing (that would be reset-password, #34/#26).
# See docs/admin-console-design.md §3.
Admin__Email=
Admin__Password=

# --- Outbound email (optional) ---
# Powers admin email invites (and, later, password reset). OPTIONAL: leave Provider unset (or
# 'none') and the app runs with a no-op sender — an admin can still create accounts by setting a
# password directly. Set Provider=smtp to enable real delivery; the app then fails to start unless
# Smtp__Host and FromAddress are set. Any provider that offers SMTP works (Gmail, SES, SendGrid,
# Mailgun, Postmark, Resend). See docs/feature-36-account-provisioning.md §6.
Email__Provider=
Email__FromAddress=no-reply@keepr.app
Email__FromName=Keepr
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__UseStartTls=true
# Origin for links in emails (the claim link). Empty falls back to Sharing__PublicBaseUrl.
Email__PublicBaseUrl=
Email__InviteExpiryDays=7

# --- Cloudflare R2 ---
Storage__AccountId=your-r2-account-id
Storage__AccessKey=your-r2-access-key
Storage__SecretKey=your-r2-secret-key
Storage__Bucket=media
# Leave ServiceUrl empty for R2 (derived from AccountId). Dev uses MinIO via appsettings.Development.json.
Storage__ServiceUrl=
# Host baked into presigned URLs, i.e. the one the BROWSER must reach. Leave empty unless the API
# reaches storage by a name the browser can't resolve (e.g. the API in Docker using "minio:9000"
# while the browser needs "localhost:9000"). Empty = same as ServiceUrl, which is right for R2.
Storage__PublicUrl=
